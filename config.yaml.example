# Server Configuration
server:
  host: "0.0.0.0"
  port: 8080
  mode: "debug"
  web_root: "./web"  # 前端静态资源根目录（SPA 首页 index.html 所在目录）

  # CORS 白名单：仅当前后端分离部署、前端域名与服务不同源时才需要填。
  # 留空 = 仅同源（前端由本服务直接托管时最安全，不产生任何 CORS 响应头）。
  # 示例： ["https://console.example.com", "http://localhost:5173"]
  cors_allowed_origins: []

  # 可信反向代理：留空 = 不信任任何代理，客户端 IP 取 TCP 真实来源，
  # 可防止伪造 X-Forwarded-For 绕过登录限速。
  # 部署在 nginx / 负载均衡之后时必须填写代理地址，否则所有请求会被视为同一 IP。
  # 示例： ["127.0.0.1", "172.16.0.0/12"]
  trusted_proxies: []

# Neo4j Database
database:
  neo4j:
    uri: "neo4j://127.0.0.1:7687"
    username: "neo4j"
    password: "${NEO4J_PASSWORD}"
    database: "neo4j"
    max_connection_pool_size: 50
    connection_acquisition_timeout: 30s
    max_transaction_retry_time: 5s
    max_retry_attempts: 5
    retry_backoff: 2s

# AI Configuration (DeepSeek)
ai:
  provider: "deepseek"
  api_key: "${DEEPSEEK_API_KEY}"
  model: "deepseek-chat"
  base_url: "https://api.deepseek.com"
  timeout: 30

# Scanner Configuration
scanner:
  concurrency: 5
  timeout: 300
  user_agent: "SecurityScanner/1.0 (+http://security-agent.local)"
  max_depth: 3
  max_pages: 100
  respect_robots: true

  # 扫描限速：对被测站点的速率约束（安全合规要求，同时避免触发目标 WAF 封禁）
  rate_limit:
    enabled: true          # 默认开启
    requests_per_sec: 5    # 整轮扫描每秒最多发出的请求数（全局令牌桶）
    burst: 5               # 瞬时突发容量，留 0 则自动取 requests_per_sec 向上取整
    min_gap_ms: 200        # 对同一主机两次请求的最小间隔（毫秒）

# Scheduler
scheduler:
  enabled: true
  max_concurrent_scans: 3

# Sensitive Info Detection
sensitive:
  keywords:
    - "password"
    - "secret"
    - "api_key"
    - "token"
    - "credential"
    - "private_key"
  regex_patterns:
    - "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b"
    - "\\b\\d{3}-\\d{2}-\\d{4}\\b"
    - "-----BEGIN (RSA |EC )?PRIVATE KEY-----"
  file_extensions:
    - ".sql"
    - ".bak"
    - ".config"
    - ".conf"
    - ".env"
    - ".git"
    - ".svn"
    - ".htaccess"
    - ".htpasswd"

  # 本单位敏感信息样例：粘贴几条真实数据的样子即可，平台自动派生匹配规则。
  # 无需手写正则，适合不具备正则能力的运维人员。
  # 派生规则：样例本身作为高置信关键词；含 @ 的样例追加 "@域名"；
  #           长度 >= 8 的纯数字/字母数字样例按「首尾字面量 + 中间通配」泛化。
  samples: []
    # - "330106199001011234"     # 身份证样例 -> \b3301\d{12}34\b
    # - "admin@example.com"      # 邮箱样例   -> 字面量 + "@example.com"
    # - "EMP20240001"            # 工号样例   -> \bEMP[0-9A-Za-z]{6}01\b

# Alert Channels
alerts:
  enabled: true
  channels:
    - type: "webhook"
      url: "${WEBHOOK_URL}"

# Logging
logging:
  level: "debug"
  format: "text"
  output: "stdout"

# 认证与授权（安全关键配置，不可省略）
auth:
  # JWT 签名密钥。强烈建议用环境变量注入而不是明文写在这里：
  #   export JWT_SECRET="$(openssl rand -base64 48)"
  # 要求 >= 32 字符，否则服务拒绝启动（HS256 弱密钥可被离线爆破并伪造管理员令牌）。
  # 若这里仍是未替换的 ${JWT_SECRET} 占位符，服务会自动生成随机密钥兜底，
  # 但进程重启后所有登录态失效，仅作为避免"零配置直接开门"的保险。
  jwt_secret: "${JWT_SECRET}"
  token_expire_hours: 72

  # 登录失败限速（防口令爆破）
  rate_limit:
    enabled: true        # 默认开启
    max_failures: 5      # 窗口内允许的失败次数
    window_sec: 300      # 统计窗口（秒）
    lock_sec: 900        # 触发后的锁定时长（秒）

# 自主智能体
agent:
  enabled: true        # 是否启用自主智能体
  max_turns: 24        # 单任务最大推理轮次（达到上限仍未完成则标记 failed，防失控）
  model: ""            # 可选：覆盖默认模型供应商（留空则用 ai.default）
